# Treat every file as text with LF line endings by default.
* text=auto eol=lf

# Explicit rule for Python files.
*.py text eol=lf

# Binary files (images, PDFs, archives).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.exe binary

# YAML as text - this matters for Home Assistant configuration.
*.yaml text eol=lf
*.yml text eol=lf

# JSON as text.
*.json text eol=lf

# Markdown as text.
*.md text eol=lf
